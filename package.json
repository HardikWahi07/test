{
  "name": "veyrith-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:public": "npm run dev --workspace @veyrith/public",
    "dev:admin": "npm run dev --workspace @veyrith/admin",
    "dev:server": "node server.js",
    "env:init": "node scripts/init-env.mjs",
    "build": "npm run build --workspace @veyrith/core && npm run build --workspace @veyrith/public && npm run build --workspace @veyrith/admin",
    "admin:bootstrap": "tsx packages/core/src/scripts/bootstrap-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "razorpay": "^2.9.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "engines": {
    "node": ">=20.9"
  }
}

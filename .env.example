# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Public and private app origins
PUBLIC_SITE_URL=https://veyrithlabs.com
ADMIN_CMS_URL=https://admin.veyrithlabs.com
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Customer email verification (SMTP server; server-side only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# One-time administrator bootstrap (set only for the bootstrap command)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Razorpay credentials (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayU India credentials (server-side only)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=test
